# O ambiente de alguns devs roda com NODE_ENV=production (e/ou omit=dev), o que
# faz `npm install` podar as devDependencies (vite, vitest, eslint, tsc,
# tailwind) e quebrar build/lint/test. `include=dev` é o inverso de `omit=dev` e
# vence quando ambos estão presentes, garantindo que as devDeps sempre instalem.
# Ver TASK-CHORE-011.
include=dev
